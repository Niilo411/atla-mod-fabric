{
  "schemaVersion": 1,
  "id": "elemental_paths",
  "version": "${version}",
  "name": "Elemental Paths",
  "description": "Elemental channeling. Four elements, eight sub-elements and over a hundred abilities behind a progression tree you unlock as you play.",
  "authors": ["Niilo Kahn"],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.niilo411.elementalpaths.ElementalPaths"],
    "client": ["io.github.niilo411.elementalpaths.client.ElementalPathsClient"]
  },
  "mixins": [
    "elemental_paths.mixins.json",
    { "config": "elemental_paths.client.mixins.json", "environment": "client" }
  ],
  "accessWidener": "elemental_paths.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
